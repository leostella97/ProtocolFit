{
  "name": "@protocolfit/web",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend do ProtocolFit — Next.js App Router + Tailwind CSS v4 + shadcn/ui + recharts + framer-motion.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:pages": "node scripts/copiar-modelos.mjs && next build && node scripts/verificar-pwa.mjs",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "icones": "node scripts/gerar-icones.mjs",
    "verificar:pwa": "node scripts/verificar-pwa.mjs",
    "testar:motor": "tsx scripts/testar-motor-navegador.ts",
    "testar:local": "tsx scripts/testar-repositorio-local.ts"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.15.0",
    "lucide-react": "^0.525.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.1.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
