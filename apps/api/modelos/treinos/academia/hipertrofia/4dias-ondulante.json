        { "nome": "Panturrilha em pé", "grupo": "panturrilha", "tipo": "isolador", "series": 4, "repeticoes_min": 10, "repeticoes_max": 15, "descanso_segundos": 45, "percentual_carga_peso_corporal": 0.4, "prescricao_fixa": true, "dicas": "Amplitude máxima: alonga embaixo, contrai em cima. Volume de panturrilha soma com o do dia 2." },
