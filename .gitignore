# Dependências instaladas (nunca versionar)
node_modules/

# Artefatos de build
dist/
.next/
out/

# Banco de dados SQLite gerado em tempo de execução (dados dos usuários)
*.db
*.db-wal
*.db-shm
apps/api/dados/

# Site estático gerado para o GitHub Pages (modelos copiados + exportação)
apps/web/public/modelos/
apps/web/out/

# Arquivos temporários de teste local
paginas-teste/
*.log

# Repositório do site raiz da conta (tem git próprio, publicado separadamente)
.site-raiz/

# Variáveis de ambiente locais (segredos!)
.env
.env.local

# Logs e arquivos temporários
*.log
.DS_Store
Thumbs.db

# Cache do TypeScript / Next.js
*.tsbuildinfo
next-env.d.ts
