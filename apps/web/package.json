{
  "name": "@protocolfit/web",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend do ProtocolFit — Next.js App Router + Tailwind CSS v4 + shadcn/ui + recharts + framer-motion.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:pages": "node scripts/copiar-modelos.mjs && next build && node scripts/verificar-pwa.mjs",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "icones": "node scripts/gerar-icones.mjs",
    "verificar:pwa": "node scripts/verificar-pwa.mjs",
    "testar:motor": "tsx scripts/testar-motor-navegador.ts",
    "testar:local": "tsx scripts/testar-repositorio-local.ts"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
