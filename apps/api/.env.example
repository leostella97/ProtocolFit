# ============================================================================
# ProtocolFit — variáveis de ambiente do backend (copie para `.env` e ajuste)
# ============================================================================

# Porta em que o servidor Fastify escuta
PORTA=3333

# Segredo usado para assinar os tokens JWT (TROQUE em produção!)
PROTOCOLFIT_JWT_SECRET=troque-este-segredo-em-producao

# Origem do frontend permitida pelo CORS (Next.js em desenvolvimento)
PROTOCOLFIT_ORIGEM_WEB=http://localhost:3000
