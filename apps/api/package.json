{
  "name": "@protocolfit/api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend do ProtocolFit — Fastify + TypeScript + SQLite com motor de cálculo determinístico (Mifflin-St Jeor) e clonagem de planos a partir de modelos JSON.",
  "type": "module",
  "main": "dist/servidor.js",
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/servidor.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/jwt": "^10.2.8",
    "@fastify/rate-limit": "^11.3.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
